                    .htmx-request.button {{ opacity: 0.5; pointer-events: none; }}
                </style>
            </head>
            <body class="min-h-screen relative overflow-x-hidden pt-32 pb-12 px-6">
                <!-- Background decorative elements -->
                <div class="fixed top-[-10%] left-[-10%] w-[40%] h-[40%] rounded-full bg-indigo-500/10 blur-[120px] -z-10 pointer-events-none"></div>
                <div class="fixed bottom-[-10%] right-[-10%] w-[40%] h-[40%] rounded-full bg-blue-500/10 blur-[120px] -z-10 pointer-events-none"></div>

                <Navbar />

                <div class="max-w-4xl mx-auto space-y-12">
                    <header class="space-y-4">
                        <a href="/" class="text-xs font-bold uppercase tracking-widest text-indigo-400 hover:text-white transition-colors">&larr; Back to Hub</a>
                        <h1 class="text-5xl font-display font-extrabold tracking-tight text-white">Native Reactivity</h1>
                        <p class="text-lg text-slate-400 leading-relaxed max-w-2xl">
                            Traditional frameworks hydrate Megabytes of JavaScript to manage state. PalStack handles it via <span class="text-indigo-400 font-semibold underline decoration-indigo-400/30 underline-offset-4 text-sm uppercase tracking-widest">Server-Side Signals</span>.

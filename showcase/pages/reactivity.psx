                        <div class="space-y-3 z-10">
                            <h3 class="text-sm font-black uppercase tracking-[0.2em] text-slate-500">Atomic Pointers in Zig Memory</h3>
                            <div class="text-8xl font-display font-black text-white tracking-tight drop-shadow-2xl">
                                0
                            </div>
                        </div>

                        <div class="space-y-6 z-10 w-full max-w-sm">

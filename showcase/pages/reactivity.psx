                                Evaluate Signal
                            </button>
                            
                            <div id="thinking" class="htmx-indicator">
                                <div class="flex items-center justify-center gap-2 text-indigo-400 font-display font-bold animate-pulse text-sm">
                                    <div class="h-1.5 w-1.5 rounded-full bg-current"></div>
